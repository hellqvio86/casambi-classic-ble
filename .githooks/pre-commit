#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"


# Baseline security scans (TruffleHog & Trivy)
if [[ -d "${HOME}/.local/bin" && ":${PATH}:" != *":${HOME}/.local/bin:"* ]]; then
    export PATH="${HOME}/.local/bin:${PATH}"
fi

echo "--> Running Trivy vulnerability scan..."
if command -v trivy >/dev/null 2>&1; then
    trivy fs --severity HIGH,CRITICAL --exit-code 1 .
elif command -v docker >/dev/null 2>&1; then
    docker run --rm -v "$REPO_ROOT":/src -v trivy-cache:/root/.cache -w /src aquasec/trivy:latest fs --severity HIGH,CRITICAL --exit-code 1 .
else
    echo "ERROR: trivy or docker is required for pre-commit checks!" >&2
    exit 1
fi


echo "=========================================="
echo "Running pre-commit checks..."
echo "=========================================="

echo "--> [1/3] Running TruffleHog secret scan..."
if ! command -v trufflehog >/dev/null 2>&1; then
    echo "ERROR: trufflehog is mandatory for git pre-commit checks but was not found in PATH!" >&2
    echo "Install trufflehog via: curl -sL https://github.com/trufflesecurity/trufflehog/releases/download/v3.99.7/trufflehog_3.99.7_linux_amd64.tar.gz | tar -xz -C ~/.local/bin trufflehog" >&2
    exit 1
fi

# Check for accidental credential filenames in staged index
for file in $(git diff --cached --name-only); do
    case "$file" in
        casambi.yaml|*.yaml.enc|*.env|*.env.*|*credential*|*secret*.yaml|*secret*.json)
            echo "BLOCKED: Attempting to commit restricted credentials file: $file" >&2
            exit 1
            ;;
    esac
done

# Run trufflehog scan on staged changes and git repository
git diff --cached | trufflehog stdin --fail
trufflehog git file://"$REPO_ROOT" --fail

echo "--> [2/3] Running lint..."
make lint

echo "--> [3/3] Running tests..."
make test

echo "=========================================="
echo "All pre-commit checks passed successfully!"
echo "=========================================="
exit 0
